[Unit]
Description={{.Description}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{.ExecPath}}{{range .ExecArgs}} {{.}}{{end}}
Restart=always
RestartSec=2
{{if .User}}User={{.User}}{{end}}
{{range $k,$v := .Environment}}Environment="{{$k}}={{$v}}"
{{end}}

[Install]
WantedBy=multi-user.target

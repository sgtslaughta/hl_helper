#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{.Name}}
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: {{.Description}}
### END INIT INFO

DAEMON={{.ExecPath}}
DAEMON_ARGS="{{range .ExecArgs}} {{.}}{{end}}"
PIDFILE=/run/{{.Name}}.pid
case "$1" in
  start) start-stop-daemon --start --background --make-pidfile --pidfile $PIDFILE --exec $DAEMON -- $DAEMON_ARGS ;;
  stop)  start-stop-daemon --stop --pidfile $PIDFILE ;;
  restart) $0 stop; sleep 1; $0 start ;;
  status) start-stop-daemon --status --pidfile $PIDFILE; case $? in 0) echo running;; *) echo stopped;; esac ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1;;
esac

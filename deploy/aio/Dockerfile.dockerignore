# AIO-specific ignore (BuildKit picks <dockerfile>.dockerignore over root).
# AIO bundles server (Python), webui (Next.js), agent (Go) — needs all source trees.
.git
.github
.gitlab-ci.yml
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
node_modules
site
docs
proto
tests
server/tests
agent/build
agent/.go-cache
deploy/server
deploy/webui
deploy/agent
deploy/compose
*.db
*.sqlite
*.sqlite3
.env
.env.*
.coverage
coverage.xml
sbom-*.json
.dockerignore
.gitignore
*.md

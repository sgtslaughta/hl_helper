<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hl.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/hl-agent</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HL_STATE_DIR</key><string>/var/lib/hl-agent</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>StandardOutPath</key><string>/var/log/hl-agent.out.log</string>
  <key>StandardErrorPath</key><string>/var/log/hl-agent.err.log</string>
</dict>
</plist>

# hl_helper agent — allowed package management commands
hl-agent ALL=(root) NOPASSWD: /usr/bin/pacman -Sy
hl-agent ALL=(root) NOPASSWD: /usr/bin/pacman -Su --noconfirm
hl-agent ALL=(root) NOPASSWD: /usr/bin/pacman -S --noconfirm *
hl-agent ALL=(root) NOPASSWD: /usr/bin/checkrestart
hl-agent ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
hl-agent ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff
Defaults!/usr/bin/pacman !requiretty

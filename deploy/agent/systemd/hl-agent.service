[Unit]
Description=hl-helper agent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/hl-agent
Restart=always
RestartSec=2
StateDirectory=hl-agent
Environment=HL_STATE_DIR=/var/lib/hl-agent
WatchdogSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hl-agent /usr/local/bin
PrivateTmp=true
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

.github
.gitlab-ci.yml
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
node_modules
site
docs
proto
tests
server
webui
agent/build
agent/.go-cache
deploy/server
deploy/webui
*.db
*.sqlite
*.sqlite3
.env
.env.*
.coverage
coverage.xml
sbom-*.json
.dockerignore
.gitignore
*.md
